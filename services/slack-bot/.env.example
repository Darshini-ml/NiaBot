# Slack credentials (from api.slack.com → Your App)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# NiaAI app URL (default: http://localhost:3000)
NIA_APP_URL=http://localhost:3000

# Internal service token (must match NIA_INTERNAL_TOKEN on the NiaAI server)
NIA_INTERNAL_TOKEN=
