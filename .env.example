# ───────────────────────────────────────────────
# NiaAI Gateway
# ───────────────────────────────────────────────
# NiaAI provider gateway URL (required)
NIA_GATEWAY_URL=https://api.nia.naslabs.ai/v1
# API key for the NiaAI gateway (required)
NIA_API_KEY=

# ───────────────────────────────────────────────
# App / Internal
# ───────────────────────────────────────────────
# Public URL of this Next.js app (used by bots to call back)
NIA_APP_URL=http://localhost:3000
# Shared secret between app and bot services
NIA_INTERNAL_TOKEN=
# Model overrides (optional)
ENHANCE_MODEL=google/gemini-2.5-flash
IMAGE_MODEL=openai/gpt-image-1
# Disable automations feature (optional)
FEATURE_AUTOMATIONS=

# ───────────────────────────────────────────────
# Direct provider keys (optional, gateway is preferred)
# ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Local Ollama instance (optional)
OLLAMA_BASE_URL=

# ───────────────────────────────────────────────
# Slack App (bot + connector OAuth share one app)
# ───────────────────────────────────────────────
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-Level Token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=
# Signing Secret from api.slack.com
SLACK_SIGNING_SECRET=
# OAuth Client ID & Secret (from api.slack.com → Basic Information)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ───────────────────────────────────────────────
# Discord App (bot + connector OAuth share one app)
# ───────────────────────────────────────────────
# Bot token from discord.com/developers
DISCORD_BOT_TOKEN=
# Application (Client) ID
DISCORD_CLIENT_ID=
# OAuth2 Client Secret
DISCORD_CLIENT_SECRET=
# Guild ID for guild-scoped commands (optional)
DISCORD_GUILD_ID=

# ───────────────────────────────────────────────
# Session / Security
# ───────────────────────────────────────────────
# HMAC secret for signing the nia_user_id httpOnly cookie (any strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# ───────────────────────────────────────────────
# Connectors
# ───────────────────────────────────────────────
# Public base URL of this app (builds OAuth redirect URIs automatically)
APP_BASE_URL=http://localhost:3000
# AES-256-GCM key for encrypting OAuth tokens at rest (64-char hex = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_ENCRYPTION_KEY=
